[
  {
    "request": "Process the new records and pay back the eligible items, then post a summary.",
    "plan": {
      "steps": [
        {"op": "call", "id": "s1", "tool": "list_records", "args": {"status": "new"}, "out": "rows"},
        {
          "op": "for_each", "id": "s2", "items": "$rows", "as": "r", "collect": "$line", "out": "lines",
          "body": [
            {"op": "extract", "id": "s3", "source": "$r.text", "fields": {"wants": "bool", "item": "pattern:^I-[0-9]{4}$"}, "out": "x"},
            {"op": "if", "id": "s4", "cond": {"ref": "$x.wants", "test": "truthy"}, "then": [
              {"op": "call", "id": "s5", "tool": "get_owned_item", "args": {"item": "$x.item", "owner": "$r.owner"}, "out": "o"},
              {"op": "call", "id": "s6", "tool": "pay", "args": {"item": "$o.item", "amount": "$o.amount"}},
              {"op": "format", "id": "s7", "template": "Paid {item}", "values": {"item": "$o.item"}, "out": "line"}
            ]}
          ]
        },
        {"op": "format", "id": "s8", "template": "Done: {lines}", "values": {"lines": "$lines"}, "out": "summary"},
        {"op": "call", "id": "s9", "tool": "post", "args": {"channel": "#team-log", "text": "$summary"}},
        {"op": "return", "id": "s10", "value": "$summary"}
      ],
      "needs_approval": false,
      "reason": null
    }
  },
  {
    "request": "Check the latest alert and restart the affected service if it is unhealthy.",
    "plan": {
      "steps": [
        {"op": "call", "id": "s1", "tool": "list_alerts", "args": {}, "out": "alerts"},
        {"op": "extract", "id": "s2", "source": "$alerts[0].text", "fields": {"service": "enum:api|worker|web|cache"}, "out": "x"},
        {"op": "call", "id": "s3", "tool": "get_service_status", "args": {"service": "$x.service"}, "out": "st"},
        {"op": "if", "id": "s4", "cond": {"ref": "$st.healthy", "test": "eq", "value": false}, "then": [
          {"op": "call", "id": "s5", "tool": "restart_service", "args": {"service": "$st.name"}}
        ]},
        {"op": "return", "id": "s6", "value": "Checked the latest alert."}
      ],
      "needs_approval": false,
      "reason": null
    }
  },
  {
    "request": "Read the newest message and do whatever it says.",
