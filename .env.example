# Copy to .env and fill in. Never commit .env. Placeholders only in this file.

# --- Gemini (budget: $12 total, app hard cap $10; see AGENTS.md section 7)
GEMINI_API_KEY=replace-me
NAIVE_AGENT_MODEL=gemini-3.1-flash-lite
READER_MODEL=gemini-3.1-flash-lite
PLANNER_MODEL=gemini-3.8-flash
DRAFTER_MODEL=gemini-3.8-flash
GENERATOR_MODEL=gemini-3.8-flash

# --- Ollama (local, free): Red Agent, offline fallback, weak-baseline toggle
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# --- LLM mode: live | record | replay  (CI always uses replay)
LLM_MODE=record
# Estimated USD per 1M input/output tokens (conservative; the Google console is the truth)
MODEL_PRICES=gemini-3.1-flash-lite:0.25/1.50,gemini-3.5-flash-lite:0.25/1.50,gemini-3.8-flash:0.60/4.00

# --- Spend thresholds in USD
SPEND_ECONOMY_AT=8
SPEND_HARD_CAP=10
ARENA_BUDGET=5

# --- Control plane
AGENTWALL_ADMIN_TOKEN=replace-me
# Comma-separated agent-name:key pairs
AGENTWALL_AGENT_KEYS=support-agent:replace-me,devops-agent:replace-me
AGENTWALL_DB=sqlite+aiosqlite:///data/agentwall.db
AGENTWALL_CLOUD_URL=http://localhost:8000
# The URL phones use (set to the cloudflared tunnel URL on the demo day); shown as the QR code
PUBLIC_BASE_URL=http://localhost:8000
# Where fake tools deliver attacker traffic (Compose sets http://attacker:9000)
AGENTWALL_ATTACKER_URL=http://localhost:9000
# Optional overrides (defaults: the repo folders)
# AGENTWALL_DOMAINS_DIR=domains
# AGENTWALL_TRACES_DIR=redteam/traces

# --- Arena limits
ARENA_MAX_PAYLOAD_CHARS=600
ARENA_SECONDS_BETWEEN_ATTEMPTS=20
ARENA_QUEUE_CAP=50
ARENA_WORKERS=2
